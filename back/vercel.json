{
  "version": 2,
  "builds": [
    {
      "src": "back/config/wsgi.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.12" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "back/config/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "back/static/$1"
    }
  ]
}